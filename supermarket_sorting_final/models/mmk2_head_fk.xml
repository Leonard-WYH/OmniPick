<!-- 中文说明：仅供相机外参正运动学使用的精简 MuJoCo 模型；无执行时序参数。 -->
<mujoco model="mmk2_head_fk">
  <compiler angle="radian"/>
  <option gravity="0 0 0"/>

  <worldbody>
    <body name="mmk2">
      <freejoint name="base_joint"/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>

      <body name="agv_link" pos="0.02371 0 0">
        <body name="slide_link" pos="0 0 1.311">
          <joint name="slide_joint" type="slide" axis="0 0 -1"/>
          <inertial pos="0 0 0" mass="0.1" diaginertia="0.01 0.01 0.01"/>

          <body name="head_yaw_link" pos="0.18375 0 0.023" euler="0 0 1.5708">
            <joint name="head_yaw_joint" type="hinge" axis="0 0 1"/>
            <inertial pos="0 0 0" mass="0.1" diaginertia="0.01 0.01 0.01"/>

            <body name="head_pitch_link" pos="0.00099952 0.000031059 0.058"
                  quat="0.5 -0.5 0.5 -0.5">
              <joint name="head_pitch_joint" type="hinge" axis="0 0 -1"/>
              <inertial pos="0 0 0" mass="0.1" diaginertia="0.01 0.01 0.01"/>

              <body pos="0.0755 -0.1855 0" quat="0 0.70711 0 -0.70711">
                <body name="head_cam" pos="-0.035 0 0" euler="-0.33 0 0">
                  <site name="headeye" euler="3.1416 0 0" size="0.001"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
